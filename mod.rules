ID = "morgott.performance"
Name = "Performance"
Version = "0.1.0"
Author = "Morgott"
CompatibleGameVersions = ["0.30.5"]
Description = "Fewer garbage-collection stutters: removes a per-frame memory allocation that every ship's network ports make in vanilla. Gameplay and multiplayer sync are unchanged; players without the mod can join. If a game update changes the patched code, the mod switches itself off and the game runs vanilla. Requires Yet Another Mod Loader."
Dependencies = ["3577650065"]
ModifiesMultiplayer = false
StringsFolder = "strings"
